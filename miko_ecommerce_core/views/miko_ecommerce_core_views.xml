<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_channel_list" model="ir.ui.view">
        <field name="name">miko.ecommerce.channel.tree</field>
        <field name="model">miko.ecommerce.channel</field>
        <field name="arch" type="xml">
            <tree string="Stores">
                <field name="name"/>
                <field name="platform"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="last_sync"/>
                <field name="failed_job_count" string="Failed"
                       decoration-danger="failed_job_count &gt; 0"/>
            </tree>
        </field>
    </record>

    <record id="view_channel_form" model="ir.ui.view">
        <field name="name">miko.ecommerce.channel.form</field>
        <field name="model">miko.ecommerce.channel</field>
        <field name="arch" type="xml">
            <form string="Store">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_jobs" type="object"
                                class="oe_stat_button" icon="fa-tasks">
                            <field name="job_count" widget="statinfo" string="Jobs"/>
                        </button>
                    </div>
                    <group>
                        <group string="Store">
                            <field name="name"/>
                            <field name="platform"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="last_sync"/>
                            <field name="active"/>
                        </group>
                        <group string="What happens to imported orders">
                            <field name="auto_confirm_orders"/>
                            <field name="auto_create_invoice"/>
                            <field name="import_from_date"/>
                            <div colspan="2" class="text-muted">
                                Both are off to begin with. Import first, look at
                                what arrived, then decide. A connector that confirms
                                and invoices on its first run produces a mess that
                                takes days to unpick.
                            </div>
                        </group>
                    </group>
                    <group string="Where things land">
                        <group>
                            <field name="team_id"/>
                            <field name="warehouse_id"/>
                            <field name="pricelist_id"/>
                        </group>
                        <group>
                            <field name="journal_id"/>
                            <field name="default_customer_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_job_list" model="ir.ui.view">
        <field name="name">miko.ecommerce.job.tree</field>
        <field name="model">miko.ecommerce.job</field>
        <field name="arch" type="xml">
            <tree string="Sync jobs" create="false"
                  decoration-danger="state == 'failed'"
                  decoration-warning="state == 'blocked'"
                  decoration-success="state == 'done'"
                  decoration-muted="state == 'skipped'">
                <field name="create_date" string="When"/>
                <field name="channel_id"/>
                <field name="direction" optional="show"/>
                <field name="operation"/>
                <field name="external_ref"/>
                <field name="state"/>
                <field name="guidance" string="What to do" optional="show"/>
                <field name="attempts"/>
                <field name="next_retry" optional="hide"/>
                <field name="odoo_ref" optional="hide"/>
                <field name="error" optional="hide"/>
                <button name="action_retry" type="object" string="Retry now"
                        icon="fa-refresh"/>
            </tree>
        </field>
    </record>

    <record id="view_job_search" model="ir.ui.view">
        <field name="name">miko.ecommerce.job.search</field>
        <field name="model">miko.ecommerce.job</field>
        <field name="arch" type="xml">
            <search string="Sync jobs">
                <field name="external_ref"/>
                <field name="operation"/>
                <filter name="failed" string="Failed"
                        domain="[('state','=','failed')]"/>
                <filter name="pending" string="Waiting"
                        domain="[('state','=','pending')]"/>
                <group>
                    <filter name="g_state" string="Status" context="{'group_by':'state'}"/>
                    <filter name="g_op" string="Operation" context="{'group_by':'operation'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_job_form" model="ir.ui.view">
        <field name="name">miko.ecommerce.job.form</field>
        <field name="model">miko.ecommerce.job</field>
        <field name="arch" type="xml">
            <form string="Sync job" create="false">
                <header>
                    <button name="action_retry" type="object" string="Retry now"
                            class="btn-primary"/>
                    <button name="action_reset_attempts" type="object"
                            string="Reset attempts"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="channel_id"/>
                            <field name="operation"/>
                            <field name="direction"/>
                            <field name="external_ref"/>
                            <field name="external_id"/>
                        </group>
                        <group>
                            <field name="attempts"/>
                            <field name="max_attempts"/>
                            <field name="next_retry"/>
                            <field name="odoo_ref"/>
                            <field name="create_date"/>
                        </group>
                    </group>
                    <group string="What to do about it">
                        <field name="guidance" nolabel="1" readonly="1"/>
                    </group>
                    <group string="Error">
                        <field name="error" nolabel="1" readonly="1"/>
                    </group>
                    <group string="Payload">
                        <field name="payload" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mapping_list" model="ir.ui.view">
        <field name="name">miko.ecommerce.mapping.tree</field>
        <field name="model">miko.ecommerce.mapping</field>
        <field name="arch" type="xml">
            <tree string="Linked records" create="false">
                <field name="channel_id"/>
                <field name="model_name"/>
                <field name="external_id"/>
                <field name="external_ref"/>
                <field name="odoo_id"/>
                <field name="last_synced"/>
            </tree>
        </field>
    </record>

    <record id="action_channel" model="ir.actions.act_window">
        <field name="name">Stores</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Install a platform connector to get started</p>
            <p>
                This module is the <b>engine</b> that store connectors run on. It
                does the parts every connector needs and nobody should write twice:
                remembering which Odoo record is which store record so nothing is
                ever imported into Odoo twice, and keeping failures in a queue that
                can be retried instead of losing them.
            </p>
            <p>
                <b>On its own it has nothing to connect to yet.</b> Add a connector
                for the platform you sell on and a store will appear here:
            </p>
            <ul>
                <li><b>Shopify Odoo Connector (Miko)</b> - orders, products,
                    customers and taxes in; stock and fulfilment tracking back out.</li>
            </ul>
            <p>
                Search the Odoo Apps store for <b>Miko</b> to find the connectors,
                or email <a href="mailto:support@tripsterdevelopers.com">support@tripsterdevelopers.com</a>
                and we will point you at the right one.
            </p>
        </field>
        <field name="res_model">miko.ecommerce.channel</field>
        <field name="view_mode">tree,form</field>
    </record>
    <record id="action_job" model="ir.actions.act_window">
        <field name="name">Sync Jobs</field>
        <field name="res_model">miko.ecommerce.job</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_job_search"/>
        <field name="context">{'search_default_failed': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing has failed.</p>
            <p>Every unit of work is a row here. A failure keeps the payload that
               caused it, so it can be fixed and run again rather than lost.</p>
        </field>
    </record>
    <record id="action_mapping" model="ir.actions.act_window">
        <field name="name">Linked Records</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing is linked yet</p>
            <p>
                Every record that crosses between Odoo and a store gets a row here,
                tying the Odoo record to its id on the store. It is what makes a
                second sync update the same order rather than create another one.
            </p>
            <p>Rows appear the first time a connector imports or exports something.</p>
        </field>
        <field name="res_model">miko.ecommerce.mapping</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_ecommerce_root" name="Store Sync" sequence="88"
              groups="sales_team.group_sale_salesman"/>
    <menuitem id="menu_ecommerce_channels" name="Stores" parent="menu_ecommerce_root"
              action="action_channel" sequence="10"/>
    <menuitem id="menu_ecommerce_jobs" name="Sync Jobs" parent="menu_ecommerce_root"
              action="action_job" sequence="20"/>
    <menuitem id="menu_ecommerce_mappings" name="Linked Records" parent="menu_ecommerce_root"
              action="action_mapping" sequence="30"/>
</odoo>
