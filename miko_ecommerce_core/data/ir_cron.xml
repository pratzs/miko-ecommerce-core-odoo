<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- numbercall and doall are deliberately absent: Odoo 18 removed both
             from ir.cron, so naming them breaks this file on 18 and 19 while
             working fine on 16 and 17.

             This only ever picks up jobs in state 'failed' whose backoff has
             elapsed. Jobs in 'blocked' are left alone on purpose: they need a
             person to change something, and retrying on a timer would burn the
             attempt budget and bury the message that says what to fix. -->
        <record id="cron_retry_failed_jobs" model="ir.cron">
            <field name="name">Store Sync: retry failed jobs</field>
            <field name="model_id" ref="model_miko_ecommerce_job"/>
            <field name="state">code</field>
            <field name="code">model._cron_retry_failed()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
